{
  "type": "module",
  "version": "0.0.3",
  "main": "lib/index.ts",
  "scripts": {
    "build": "rm -rf dist/ && deno-node-build --root . --out dist/ --entry lib/index.ts",
    "type-check": "tsc --noEmit",
    "test": "c8 --reporter lcov --reporter html --reporter text --all --include lib/ --exclude lib/**/*.spec.ts mocha lib/**/*.spec.ts",
    "lint": "eslint .",
    "update-deps": "npm-check-updates -u"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "JSONStream": "^1.3.5",
    "tar-fs": "^3.0.6",
    "tar-stream": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@k13engineering/eslint-rules": "^0.0.6",
    "@k13engineering/releasetool": "^0.0.5",
    "@types/dockerode": "^3.3.32",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "c8": "^11.0.0",
    "deno-node": "^0.0.12",
    "mocha": "^10.2.0",
    "npm-check-updates": "^20.0.2",
    "typescript": "^6.0.3"
  }
}
